# Narada voice — API keys + model selection (TEMPLATE).
#
# Copy this to ~/.narada/.voice.env and fill in your key(s). The real
# file lives OUTSIDE the repo (in ~/.narada, alongside .livekit.env) and
# must never be committed — this .example is the only version that is.
#
# Two ways to power the voice loop; fill in whichever you're using:
#
#   A) OpenRouter cascaded pipeline (STT -> LLM -> TTS). Works with the
#      key you already have; ~1-2s latency, no true barge-in.
#   B) OpenAI direct realtime S2S. Sub-second, natural; needs an OpenAI
#      key (OpenRouter cannot proxy the realtime WebSocket API).

# ── A) OpenRouter (cascaded pipeline) ────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Pipeline model choices (OpenRouter slugs — see https://openrouter.ai/models).
# Defaults favour low latency for a spoken assistant; adjust to taste.
NARADA_LLM_MODEL=openai/gpt-4o-mini
NARADA_STT_MODEL=openai/gpt-4o-mini-transcribe
NARADA_TTS_MODEL=openai/gpt-4o-mini-tts

# ── B) OpenAI direct (true realtime S2S) — leave blank if using A ─────
OPENAI_API_KEY=
NARADA_VOICE_MODEL=gpt-realtime-2.1-mini

# ── Which path the worker uses ───────────────────────────────────────
# "pipeline" (A) or "realtime" (B). Defaults to realtime for parity with
# the original design; set to pipeline to run on your OpenRouter key.
NARADA_VOICE_BACKEND=pipeline
